# Required for source-backed script generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# At least one stock provider is recommended. NASA image search needs no key.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Required only when --publish is used
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Canonical narration and subtitle alignment
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
WHISPER_MODEL=base.en
WHISPER_FALLBACK_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Quality controls
MIN_FINAL_DURATION_SECONDS=30
MAX_FINAL_DURATION_SECONDS=58
MIN_NARRATION_WORDS=85
MAX_NARRATION_WORDS=115
MIN_VISUAL_RELEVANCE_SCORE=2.0
ENABLE_ANALYTICS=false
KEEP_WORK_DIR=false
RENDER_SUBTITLE_TEST=false

# Development only. Never enable for an actual upload.
ALLOW_LOCAL_SCRIPT_FALLBACK=false

# Verified topic-level source cache. Grounded repair uses at most two API calls total.
FACT_SOURCE_CACHE_FILE=fact_source_cache.json
